# Пароль для входа в приложение
APP_PASSWORD=

# Случайная строка для подписи сессионных кук (32+ символа)
APP_AUTH_SECRET=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Публичный адрес приложения (для заголовков OpenRouter)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
